new file mode 100644
index 0000000..5339100
--- /dev/null
+++ b/static/diary.js
@@ -0,0 +1,81 @@
+(() => {
+  const dialog = document.getElementById('diary-dialog');
+  const form = document.getElementById('diary-form');
+  const body = document.getElementById('diary-body');
+  const date = document.getElementById('diary-date');
+  const status = document.getElementById('diary-status');
+  const save = form.querySelector('[type="submit"]');
+  const close = document.getElementById('diary-close');
+  const label = (zh, en) => document.documentElement.lang === 'en' ? en : zh;
+  let entry = null;
+  let loadController;
+
+  document.addEventListener('click', async event => {
+    const trigger = event.target.closest('[data-diary-open]');
+    if (!trigger || dialog.open) return;
+    const day = trigger.dataset.diaryOpen;
+    const controller = new AbortController();
+    loadController = controller;
+    entry = null;
+    body.value = '';
+    body.disabled = save.disabled = true;
+    date.textContent = day === 'today' ? label('今天', 'Today') : day;
+    status.textContent = label('正在读取…', 'Loading…');
+    dialog.showModal();
+    try {
+      const response = await fetch('/diary/' + day, {cache:'no-store', signal:controller.signal});
+      if (!response.ok) throw Error();
+      const loaded = await response.json();
+      if (controller.signal.aborted) return;
+      entry = loaded;
+      body.value = entry.body;
+      date.textContent = date.dateTime = entry.date;
+      status.textContent = '';
+      body.disabled = save.disabled = false;
+      body.focus();
+    } catch (error) {
+      if (!controller.signal.aborted) status.textContent = label('读取失败，请关闭后重试。', 'Could not load. Close and try again.');
+    }
+  });
+
+  function closeEditor() {
+    if (close.disabled) return;
+    if (entry && body.value !== entry.body && !window.confirm(label('放弃尚未保存的修改？', 'Discard unsaved changes?'))) return;
+    loadController.abort();
+    dialog.close();
+    entry = null;
+    body.value = '';
+  }
+  close.addEventListener('click', closeEditor);
+  dialog.addEventListener('cancel', event => { event.preventDefault(); closeEditor(); });
+  body.addEventListener('input', () => { status.textContent = ''; });
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (!entry || save.disabled) return;
+    if (!body.value.trim()) {
+      status.textContent = label('请填写日记正文。', 'Please write an entry.');
+      body.focus();
+      return;
+    }
+    const draft = body.value;
+    close.disabled = save.disabled = body.readOnly = true;
+    status.textContent = label('正在保存…', 'Saving…');
+    try {
+      const response = await fetch('/diary/' + entry.date, {
+        method:'POST', headers:{'Content-Type':'application/json', 'X-CSRF-Token':window.SMART_CSRF},
+        body:JSON.stringify({body:draft, revision:entry.revision})
+      });
+      const result = await response.json();
+      if (!response.ok) throw Error(result.error);
+      entry.body = draft;
+      entry.revision = result.revision;
+      const marker = document.querySelector('.day-diary[data-diary-open="' + entry.date + '"]');
+      if (marker) marker.dataset.written = 'yes';
+      status.textContent = label('日记已保存。', 'Entry saved.');
+    } catch (error) {
+      status.textContent = error.message || label('保存失败，请重试。', 'Could not save. Try again.');
+    } finally {
+      close.disabled = save.disabled = body.readOnly = false;
+    }
+  });
+})();
