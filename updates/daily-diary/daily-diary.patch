diff --git a/diary.py b/diary.py
new file mode 100644
index 0000000..c55799a
--- /dev/null
+++ b/diary.py
@@ -0,0 +1,51 @@
+"""One private journal entry per account and local calendar date."""
+from datetime import date
+import secrets
+
+from flask import jsonify, request, session
+
+
+def register(app, store):
+    @app.route('/diary/<day>', methods=['GET', 'POST'])
+    def diary_entry(day):
+        if day == 'today' and request.method == 'GET':
+            day = date.today().isoformat()
+        try:
+            if date.fromisoformat(day).isoformat() != day:
+                raise ValueError
+        except ValueError:
+            return jsonify(error='日记日期无效。'), 400
+
+        owner = store._user_id()
+        if request.method == 'GET':
+            with store._conn() as conn:
+                row = conn.execute(
+                    'SELECT body, revision FROM diary_entries WHERE user_id IS ? AND entry_date=?',
+                    (owner, day)).fetchone()
+            response = jsonify(date=day, body=row['body'] if row else '', revision=row['revision'] if row else 0)
+            response.cache_control.no_store = True
+            return response
+
+        token = session.get('smart_csrf', '')
+        if not token or not secrets.compare_digest(request.headers.get('X-CSRF-Token', ''), token):
+            return jsonify(error='请刷新页面后重试。'), 403
+        entry = request.get_json(silent=True)
+        if not isinstance(entry, dict):
+            return jsonify(error='无效的日记内容。'), 400
+        body, revision = entry.get('body'), entry.get('revision')
+        if not isinstance(body, str) or not body.strip() or len(body) > 30000:
+            return jsonify(error='请填写日记正文，最多 30000 字。'), 400
+        if type(revision) is not int or not 0 <= revision < 2**63 - 1:
+            return jsonify(error='日记版本无效，请重新打开。'), 400
+        with store._conn() as conn:
+            if revision == 0:
+                changed = conn.execute(
+                    'INSERT INTO diary_entries(user_id,entry_date,body) VALUES (?,?,?) ON CONFLICT DO NOTHING',
+                    (owner, day, body))
+            else:
+                changed = conn.execute(
+                    'UPDATE diary_entries SET body=?, revision=revision+1 '
+                    'WHERE user_id IS ? AND entry_date=? AND revision=?', (body, owner, day, revision))
+            if not changed.rowcount:
+                return jsonify(error='这篇日记已在别处修改。请复制当前文字，重新打开后核对。'), 409
+        return jsonify(revision=revision + 1)
