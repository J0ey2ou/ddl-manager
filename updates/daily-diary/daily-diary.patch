diff --git a/tests/test_diary.py b/tests/test_diary.py
new file mode 100644
index 0000000..ea6996f
--- /dev/null
+++ b/tests/test_diary.py
@@ -0,0 +1,70 @@
+from datetime import date
+from pathlib import Path
+import tempfile
+import unittest
+
+from flask import Flask
+
+from core import DDLStore
+from diary import register
+
+
+class DiaryTests(unittest.TestCase):
+    def setUp(self):
+        folder = tempfile.TemporaryDirectory()
+        self.addCleanup(folder.cleanup)
+        self.store = DDLStore(Path(folder.name) / 'test.db', Path(__file__).resolve().parents[1] / 'schema.sql')
+        self.owner = None
+        self.store.set_user_provider(lambda: self.owner)
+        app = Flask(__name__)
+        app.secret_key = 'test'
+        register(app, self.store)
+        self.client = app.test_client()
+        with self.client.session_transaction() as session:
+            session['smart_csrf'] = 'test-token'
+        self.day = '2026-11-01'
+
+    def save(self, body, revision=0, day=None):
+        return self.client.post('/diary/' + (day or self.day), json=dict(body=body, revision=revision),
+                                headers={'X-CSRF-Token': 'test-token'})
+
+    def test_today_and_dated_entries(self):
+        today = self.client.get('/diary/today')
+        self.assertEqual(today.json, dict(body='', revision=0, date=date.today().isoformat()))
+        self.assertTrue(today.cache_control.no_store)
+        self.assertEqual(self.save('第一行\n第二行 <script>').json['revision'], 1)
+        self.assertEqual(self.client.get('/diary/' + self.day).json['body'], '第一行\n第二行 <script>')
+        self.assertEqual(self.save('补充', 1).json['revision'], 2)
+        self.assertEqual(self.client.get('/diary/2026-11-02').json['body'], '')
+
+    def test_stale_revisions_preserve_saved_text_for_all_accounts(self):
+        for owner in (None, 1, 2):
+            self.owner = owner
+            self.assertEqual(self.save('原稿').status_code, 200)
+            self.assertEqual(self.save('另一篇').status_code, 409)
+            self.assertEqual(self.save('已修改', 1).status_code, 200)
+            self.assertEqual(self.save('旧窗口', 1).status_code, 409)
+            self.assertEqual(self.client.get('/diary/' + self.day).json['body'], '已修改')
+
+    def test_calendar_marks_only_owned_entries_including_adjacent_month(self):
+        self.save('私密日记')
+        self.save('上月', day='2026-10-31')
+        def marked():
+            days = self.store.calendar_month(2026, 11)['weeks']
+            return {day['date'] for week in days for day in week if day['has_diary']}
+        self.assertEqual(marked(), {'2026-10-31', self.day})
+        self.owner = 1
+        self.assertEqual(marked(), set())
+        self.assertEqual(self.client.get('/diary/' + self.day).json['body'], '')
+        self.assertEqual(self.save('本账号的记录').status_code, 200)
+        self.owner = None
+        self.assertEqual(self.client.get('/diary/' + self.day).json['body'], '私密日记')
+
+    def test_invalid_writes_leave_day_empty(self):
+        for body in ('  ', '字' * 30001, 23):
+            self.assertEqual(self.save(body).status_code, 400)
+        for day in ('2026-02-30', '20261101', 'today'):
+            self.assertEqual(self.save('正文', day=day).status_code, 400)
+        self.assertEqual(self.save('正文', -1).status_code, 400)
+        self.assertEqual(self.client.post('/diary/' + self.day, json={'body':'正文', 'revision':0}).status_code, 403)
+        self.assertEqual(self.client.get('/diary/' + self.day).json['revision'], 0)
